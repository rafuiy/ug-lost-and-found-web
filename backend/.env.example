APP_ENV=development
PORT_SERVER=:3001
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=uglf_db
DB_PORT=5432
DB_SSLMODE=disable
DB_LOG_LEVEL=warn

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY_HOURS=8

UPLOAD_DIR=./storage/private
MAX_UPLOAD_SIZE_BYTES=2097152

LOKET_LOCATION=Gedung 4 lantai dasar, Kampus D Universitas Gunadarma
LOKET_SCHEDULE=Senin–Jumat, 08.00–15.00 WIB
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@uglf.local

SEED_ADMIN_PASSWORD=change-admin-password
SEED_PETUGAS_PASSWORD=change-petugas-password

STALE_THRESHOLD_DAYS=30
STALE_CHECK_INTERVAL_HOURS=24
